# Module payloads are executed by the manager's POSIX shell on the device.
# A CRLF script breaks option parsing (`set -eu`) and the install is rejected,
# so keep every text file in the repository LF-only.
* text=auto eol=lf

*.sh text eol=lf
*.awk text eol=lf
*.prop text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.rule text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

*.apk binary
*.jar binary
*.so binary
*.ko binary
*.dex binary
*.png binary
*.jpg binary
*.webp binary
*.zip binary
