<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold-start splash screen: same background as the launcher icon, and
         the animated icon (orbiting rings + pulsing dot) replaces the static
         launcher artwork while the system splash is visible. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
