<?xml version="1.0" encoding="utf-8"?>
<!-- Center dot pops in last and settles exactly at its final drawn size —
     a decelerating curve so the dot NEVER exceeds the launcher icon's dot
     at any frame (an overshoot would flash it past the icon's geometry). -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="500"
    android:startOffset="280"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <propertyValuesHolder
        android:propertyName="alpha"
        android:valueFrom="0"
        android:valueTo="1" />
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueFrom="0"
        android:valueTo="1" />
    <propertyValuesHolder
        android:propertyName="scaleY"
        android:valueFrom="0"
        android:valueTo="1" />
</objectAnimator>
